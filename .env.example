# Copia opcional a .env.local. Nunca guardes claves en variables VITE_*.
# pnpm start usa tu cuenta y configuración NATIVAS. Setup conserva el modo legacy.
VITE_BACKEND=bridge
VITE_TTS_ENGINE=system
VITE_SPEECH_LANG=es-CO
VITE_SPEECH_RATE=1.2

# Captura actual e historial apagados por defecto.
JARVIS_AUTO_SCREEN=0
JARVIS_RECORDING=0

# El modelo/agente/pensamiento se hereda del proyecto nativo o se elige en la UI.
# PORT=5173
# OC_PORT=4097
# JARVIS_BRIDGE_PORT=8787
# OpenCode propio: directorio inicial opcional; por defecto, el directorio personal.
# JARVIS_OC_DIRECTORY=/path/to/trusted/folder
# Servidor externo local (su propietario administra el plugin de audio):
# OPENCODE_URL=http://127.0.0.1:4097
# OPENCODE_SERVER_PASSWORD=
# Registro y métricas opcionales, fuera de los proyectos:
# JARVIS_PROJECT_REGISTRY=/path/to/private/state/projects.json
# JARVIS_TIMINGS_DIR=/path/to/private/state/timings

# Whisper local opcional: pnpm whisper:setup (no descarga modelos).
# JARVIS_WHISPER_CLI=/absolute/path/to/whisper-cli
# JARVIS_WHISPER_MODEL=/absolute/path/to/ggml-model.bin
# JARVIS_WHISPER_FFMPEG=/absolute/path/to/ffmpeg
