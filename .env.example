# Copia opcional a .env.local. Nunca guardes claves en variables VITE_*.
# pnpm start carga este archivo local; pnpm run setup no sobrescribe tu perfil.
VITE_BACKEND=bridge
VITE_TTS_ENGINE=system
VITE_SPEECH_LANG=es-CO
VITE_SPEECH_RATE=1.2

# Privacidad: ambas funciones apagadas al instalar. Habilita solo con consentimiento.
# Una captura actual por pregunta, después de configurar nombre y estilo.
JARVIS_AUTO_SCREEN=0
# Historial continuo: 2 fps + micrófono/PC, últimos 30 min. Botón REC en la UI.
JARVIS_RECORDING=0

# Gratis por defecto; disponibilidad sujeta al proveedor. No cambia a pago solo.
JARVIS_OC_MODEL=opencode/deepseek-v4.1-flash-free
# Los modelos y niveles disponibles se eligen en el panel de conversaciones.
# PORT=5173
# OC_PORT=4097
# JARVIS_BRIDGE_PORT=8787
