{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4.1-flash-free",
  "small_model": "opencode/deepseek-v4.1-flash-free",
  "autoupdate": false,
  "share": "disabled",
  "instructions": [
    "ME/IDENTITY.md", "ME/USER.md", "ME/MEMORIES/BOOTSTRAP.md",
    "ME/MEMORIES/GENERAL.md", "ME/MEMORIES/SPECIFIC.md", "ME/SKILLS/INDEX.md"
  ],
  "permission": {
    "*": "ask", "question": "deny", "webfetch": "allow",
    "websearch": "allow", "jarvis_desktop_*": "allow"
  },
  "default_agent": "build"
}
